# Copy this file to .env and adjust the paths for your machine.
# .env is git-ignored: it holds machine-specific paths only, no secrets.
#
# VS Code picks it up via "python.envFile" in .vscode/settings.json, and the
# notebook's bootstrap cell also reads it directly (python-dotenv) so it works
# from a plain terminal too.

# Where the internal `ao` package lives. Semicolon-separated list of
# directories, prepended to sys.path in the order given. Point these at your
# local clones of quantresearch / ao_common.
AO_CODE_PATHS=C:\Users\ramon.balje\code\AOI\quantresearch;C:\Users\ramon.balje\code\AOI\ao_common

# Original network-drive setup, for reference:
# AO_CODE_PATHS=Z:\Public\Dirk\CodeProjects\OffDesk Assignment\quantresearch;Z:\Public\Dirk\CodeProjects\OffDesk Assignment\ao_common;Z:\Public\Dirk\CodeProjects\OffDesk Assignment

# Folder holding mm_stats_data.xlsx, prof_trades_data.csv and
# screen_trades_data.csv; the parquet caches, output_plots/ and output_data/
# are written here too. Defaults to the kernel working directory, which
# .vscode/settings.json points at <repo>/data -- so you only need this if you
# keep the data somewhere else (e.g. on the network drive).
# MONTHLY_REPORT_DATA_DIR=C:\Users\ramon.balje\code\Ramon\data
